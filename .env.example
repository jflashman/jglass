# Bridge-only secrets. Copy to .env locally; never commit real values.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Bridge-owned fixed coordinates and IANA timezone. Never commit real values.
JGLASS_WEATHER_LATITUDE=
JGLASS_WEATHER_LONGITUDE=
JGLASS_TIME_ZONE=America/New_York

# Development defaults
JGLASS_BIND_HOST=127.0.0.1
JGLASS_PORT=8787
JGLASS_WAKE_PHRASE=JARVIS
JGLASS_LOG_LEVEL=info

# Generate a long random value for any non-loopback deployment.
JGLASS_DEVICE_TOKEN=

# Optional; fixed fallback MP3s only. Dynamic greetings are never cached here.
JGLASS_DATA_DIRECTORY=services/bridge/data
