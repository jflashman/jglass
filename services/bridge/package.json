{
  "name": "@jglass/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:boot-fallbacks": "npm run build && node dist/src/generate-boot-fallbacks.js",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
